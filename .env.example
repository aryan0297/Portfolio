# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. Every NEXT_PUBLIC_* value is exposed to the
# browser by design — never put a secret behind that prefix.
# ---------------------------------------------------------------------------

# Canonical site URL. Drives metadataBase, sitemap, robots, JSON-LD, and the QR
# code. Set this to the production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://aryantiwari.dev

# ---- Identity -------------------------------------------------------------
NEXT_PUBLIC_GITHUB_USERNAME=aryan0297
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-handle
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# ---- GitHub API (optional) ------------------------------------------------
# Server-side only. Unauthenticated requests are capped at 60/hour per IP,
# which is enough for the hourly ISR revalidation but not for local dev.
# A fine-grained token with NO scopes raises the limit to 5,000/hour.
GITHUB_TOKEN=

# ---- EmailJS (contact form) ----------------------------------------------
# From https://dashboard.emailjs.com — these are public keys by design.
# Template must define: {{from_name}} {{from_email}} {{subject}} {{message}}
# If any of the three is missing, the form falls back to a prefilled mailto:.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
